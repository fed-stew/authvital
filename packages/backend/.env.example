# =============================================================================
# AuthVital Backend - Local Development
# =============================================================================
#
# Copy to .env:  cp .env.example .env
#
# =============================================================================

# Database
DATABASE_URL=postgresql://authvital:localdev123@localhost:5432/authvital

# Application
# Backend runs on 8000 (same as Docker)
# Vite dev server runs on 5173 and proxies /api to backend
BASE_URL=http://localhost:8000
PORT=8000
NODE_ENV=development

# Security (change in production!)
MASTER_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cookie secure flag - set to 'false' for local HTTP development
COOKIE_SECURE=false

# CORS (optional - BASE_URL is auto-included)
# CORS_ORIGINS=http://localhost:5173

# Email (optional - logs to console if not set)
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@example.com
# SENDGRID_FROM_NAME=AuthVital

# Super Admin bootstrap
SUPER_ADMIN_EMAIL=admin@localhost

# =============================================================================
# SERVICE ROLE (control-plane / data-plane split)
# =============================================================================
# Which plane(s) this instance serves. See docs/concepts/service-roles.md.
#   all (DEFAULT)  - everything in one process; single-container self-hosters
#                    never need to set this.
#   public         - data plane only: OAuth/OIDC, /auth/* UI, member APIs.
#                    No admin controllers, no /admin UI, no crons.
#   admin          - control plane only: /admin/* dashboard, admin APIs,
#                    background crons. Deploy behind internal ingress/IAP.
# Invalid values REFUSE TO BOOT (deliberate - no silent fallback).
#
# SERVICE_ROLE=all

# Admin dashboard origin for split deployments; added to the CORS allow-list.
# BASE_URL must ALWAYS remain the PUBLIC url (issuer/JWKS/email links).
#
# ADMIN_BASE_URL=

# =============================================================================
# WEBHOOK DELIVERY MODE
# =============================================================================
# Who delivers webhooks:
#   legacy (DEFAULT) - the core delivers webhooks in-process, exactly as
#                      before. Single-container self-hosters: leave as-is.
#   broker           - the core only writes events (syncEvent + transactional
#                      outbox); the separate authvital-broker service
#                      (packages/broker) owns all delivery, retries and
#                      failure tracking. Requires the broker to be running
#                      against the same database (or Pub/Sub subscription).
#
# WEBHOOK_DELIVERY_MODE=legacy

# =============================================================================
# GCP PUB/SUB (Optional)
# =============================================================================
# GCP project ID for Pub/Sub publishing.
# Uses Application Default Credentials (ADC) — no explicit key needed if
# running with the same service account that deploys AuthVital.
#
# Pub/Sub configuration (topic, events, enable/disable) is managed via
# the Super Admin dashboard at /admin → Pub/Sub.
#
# PUBSUB_PROJECT_ID=your-gcp-project-id
#
# For local development with the Pub/Sub emulator:
# PUBSUB_EMULATOR_HOST=localhost:8085
