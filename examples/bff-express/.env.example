# AuthVital Express BFF — copy to .env for local dev.
# In Docker these are set in docker-compose.examples.yml.

# IdP host (issuer) + this BFF's OAuth client (SPA/public client, PKCE, NO secret).
AV_HOST=https://auth.lvh.me
AV_CLIENT_ID=web-bff-client-id
# Fallback only — the BFF computes the redirect URI per-request from the incoming
# Host, so a login on {tenant}.bff.lvh.me carries a tenant-subdomain callback and
# the IdP binds tenant_id onto the token. See src/index.ts (oauthFor).
AV_REDIRECT_URI=https://bff.lvh.me/api/auth/callback

# Encrypts the httpOnly session cookie (AES-256-GCM). MUST be >= 32 chars.
# Dev-only value; generate a real one for anything beyond local UAT.
SESSION_SECRET=dev-only-insecure-session-secret-change-me-please

# Machine-to-Machine (client_credentials) client for the Integration API + /api/m2m demo.
AV_MACHINE_CLIENT_ID=local-machine-client-id
AV_MACHINE_CLIENT_SECRET=local-machine-secret-key

# Port the BFF listens on (matches the bff-express Traefik label port).
PORT=3000
