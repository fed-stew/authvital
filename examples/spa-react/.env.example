# AuthVital SPA ("My Local App") — copy to .env for local `vite dev`.
# In Docker these are baked at build time; see docker-compose.examples.yml.

# IdP host (issuer). All OAuth + API calls target this origin.
VITE_AV_HOST=https://auth.lvh.me

# OAuth client_id for this SPA (public client, PKCE-less code flow, no secret).
VITE_AV_CLIENT_ID=local-spa-client-id
